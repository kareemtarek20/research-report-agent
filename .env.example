# Copy this file to .env and fill in your values.

# --- LLM (any OpenAI-compatible endpoint) ---
# Example below uses the Xkiro gateway's free Qwen tier. For local Ollama set:
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:3b  LLM_API_KEY=ollama
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_MODEL=qwen/qwen3.8-omni-flash:free
LLM_API_KEY=
LLM_TEMPERATURE=0.3
# Deterministic temperature for planning/extraction/fact-checking:
LLM_TEMP_PRECISE=0.0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Web search (optional but recommended) ---
# Free key at https://tavily.com — without this, the agent falls back to
# scraping DuckDuckGo, which is noisier and can occasionally be rate-limited.
TAVILY_API_KEY=

# --- Academic search (optional) ---
# Semantic Scholar works keyless; a key raises rate limits.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# --- Agent behavior (hard safety limits; every run terminates) ---
MAX_SEARCH_ITERATIONS=4
MAX_RESULTS_PER_SEARCH=5
MAX_RESEARCH_ROUNDS=2
MAX_SOURCES=24
MAX_TOTAL_EVIDENCE=40
MAX_EVIDENCE_PER_SOURCE=5
MAX_PAGE_CHARS=6000
MAX_FACT_CHECKS=8
MAX_REPORT_REVISIONS=1

# --- Report quality thresholds (0-1) ---
QUALITY_EVIDENCE_COVERAGE=0.60
QUALITY_CITATION_COVERAGE=0.70
QUALITY_QUESTION_COVERAGE=0.70
QUALITY_SOURCE_QUALITY=0.45

# --- Persistent research memory (optional, needs: pip install chromadb) ---
ENABLE_MEMORY=false
MEMORY_DIR=.memory_db

# --- Observability ---
LOG_LEVEL=INFO
LOG_FILE=research_agent.log

# --- UI default research mode (quick|deep|academic|technical|competitive|fact_check|gap_analysis) ---
DEFAULT_MODE=deep
